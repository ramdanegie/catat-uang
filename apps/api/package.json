{
	"name": "api",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"build:web": "bun --cwd ../web run build",
		"serve": "bun run build:web && bun run start",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@libsql/client": "^0.15.15",
		"@elysiajs/cors": "^1.3.3",
		"@elysiajs/jwt": "^1.3.3",
		"drizzle-orm": "^0.44.4",
		"elysia": "^1.3.7"
	},
	"devDependencies": {
		"bun-types": "^1.4.2",
		"drizzle-kit": "^0.31.4",
		"typescript": "^5.9.2"
	}
}
