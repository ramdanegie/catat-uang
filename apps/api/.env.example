PORT=3000
DB_PATH=./data/app.db
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=30d

# Google OAuth (opsional — kosongkan untuk menonaktifkan tombol Google).
# Redirect URI ini WAJIB didaftarkan di Google Cloud Console
# (Credentials -> OAuth client -> Authorized redirect URIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
# Origin publik frontend (tujuan redirect setelah login Google).
FRONTEND_URL=http://localhost:5173
